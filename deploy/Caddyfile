#=====================================================================
#  服务器状态大屏 · Caddy 主配置（只有全局设置 + 站点导入）
#---------------------------------------------------------------------
#  站点本身不写在这里，而是拆成 sites/*.caddy 一个个文件：
#    sites/dash.caddy        大屏 + 你的业务后台（默认启用）
#    sites/alt-site.caddy    可选第二个站点（示例在 sites-examples/）
#
#  为什么拆：Caddy 没有「include 单个文件」以外的条件加载，
#  用 import 一个目录最省事 —— 想加站点就往 sites/ 里丢一个 .caddy，
#  想去掉就把后缀改掉，不用在两处同步一份 120 行的配置。
#
#  这个文件里没有任何一台机器的具体值，全部来自环境变量
#  （变量清单见 deploy/dashboard.env.example）。
#
#  关键约定：Cookie 名和令牌值必须和 auth.json 里的 session_token 完全一致，
#  否则「登录成功」之后仍然进不去大屏 —— 大屏是 Caddy 直接给的文件，
#  Caddy 只认这一个 Cookie 的字面值，它不知道你有什么账号密码。
#
#  两个安全默认值（故意写成「进不去」而不是「全放行」）：
#    DASH_TOKEN     缺省 __SET_ME__  → 没人能匹配上，宁可不给进
#    DASH_SHORT_KEY 缺省 disabled    → 短链路径不存在，不会意外暴露
#=====================================================================

{
	# 用自签证书，不要让 Caddy 去 ACME 申请证书
	auto_https off
	admin off
}

# 站点文件按文件名排序导入；一条都没匹配到时 Caddy 会直接报错，
# 所以 sites/ 里至少得有一个 .caddy（仓库里自带 dash.caddy）。
import {$DASH_SITES_GLOB:/etc/caddy/sites/*.caddy}
