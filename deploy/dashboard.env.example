# Caddy 的配置来源。复制成 dashboard.env（chmod 600）再改。
# 用法（docker compose）：caddy 服务的 env_file 指向这个文件。
#        （systemd）：在 caddy.service 里写 EnvironmentFile=/etc/caddy/dashboard.env
#
# 注意：这里出现的令牌等同于口令，别提交进 git。

# ---- 站点 ----
DASH_HTTPS_PORT=8443

# ---- 证书（自签，见 gen_certs.sh）----
DASH_CERT_FILE=/etc/caddy/certs/server-fullchain.crt
DASH_KEY_FILE=/etc/caddy/certs/server.key
DASH_CERTS_DIR=/etc/caddy/certs

# ---- 登录网关 ----
# Caddy 反代到哪里。网关只监听本机/内网，不要把它 publish 到公网。
DASH_AUTH_UPSTREAM=127.0.0.1:8766

# ---- 会话 Cookie ----
# 必须与 auth.json 的 session_token 一致；改了 auth.json 就要同步改这里。
DASH_COOKIE=DashSession
DASH_TOKEN=__SET_ME__

# ---- 大屏静态文件目录（宿主路径，挂进 Caddy 容器后是同一处）----
DASH_STATUS_DIR=/srv/dashboard/status

# 访问日志（fail2ban 的 logpath 要指向同一个文件）
DASH_ACCESS_LOG=/var/log/caddy/access.log

# ---- 短网址入口 ----
# 24 位随机 hex，例如 openssl rand -hex 12 生成
# 缺省 disabled = 短链功能关闭
DASH_SHORT_KEY=disabled

# ---- 登录后其它路径反代到哪（你的业务后台）----
DASH_APP_UPSTREAM=127.0.0.1:8001
